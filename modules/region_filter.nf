
/**
 * Filters a DIMACS or METIS graph using RegionFilter.  
 *
 * **Inputs**  
 * `context`: Execution context, passed through unchanged.  
 * `executable`: RegionFilter executable, prebuilt or supplied by a build process.  
 * `graph`: Input graph in DIMACS (`.gr`) or METIS format.  
 * `opts`: Map of filtering parameters.  
 *
 * **Required parameters (`opts`)**  
 * Exactly one of `U` or `k` must be specified.  
 * `U`: Maximum fragment size.  
 * `k`: Number of blocks, used to derive U.  
 *
 * **Optional parameters (`opts`)**  
 * `eps`: Imbalance for k-based U calculation (default: 0.03).  
 * `region_factor`: Region size factor (default: 0.5).  
 * `region_factors`: Comma-separated string or list of factors for successive rounds.  
 * `regions`: Number of regions.  
 * `lloyd`: Lloyd iterations (default: 3).  
 * `terminal_fraction`: Terminal fraction (default: 0.3).  
 * `margin`: Region margin (default: 1).  
 * `terminals`: `far`, `center`, or `ball`.  
 * `ball_fraction`: Ball fraction (default: 0.3).  
 * `rounds`: Number of rounds (default: 1).  
 * `min_rounds`: Minimum rounds required to keep an edge (default: 1).  
 * `centers`: `random` or `spread`.  
 * `spread_fraction`: Spread fraction (default: 0.3).  
 * `cut_side`: `source`, `sink`, or `both`.  
 * `tau`: Tiny cut threshold (default: 5).  
 * `seed`: Random seed (default: 0).  
 * `dump_pairs`: Optional pair mode, `region` or `auto`.  
 *
 * **Optional switches (`opts`)**  
 * `pin_ring`, `closed`, `no_fallback`, `no_tiny_cuts`, `verbose`.  
 *
 * **Outputs**  
 * `graph`: Contracted fragment graph (`fragments.graph`).  
 * `mapping`: Original vertex-to-fragment mapping (`fragment_mapping.txt`).  
 * `regions`: Region information (`regions.txt`).  
 * `cut_edges`: Cut edges (`cut_edges.txt`).  
 * `pairs`: Optional pair files generated by `dump_pairs`.  
 * `log`: Combined stdout and stderr (`region_filter.log`).  
 * All outputs retain the original `context`.  
 *
 * **Requirements**  
 * The supplied executable must be compatible with the execution environment.  
 */
process REGION_FILTER {
    label 'filtering'

    input:
    tuple val(context),
        path(executable),
        path(graph),
        val(opts)

    output:
    tuple val(context), path('fragments.graph'),
        emit: graph

    tuple val(context), path('fragment_mapping.txt'),
        emit: mapping

    tuple val(context), path('regions.txt'),
        emit: regions

    tuple val(context), path('cut_edges.txt'),
        emit: cut_edges

    tuple val(context), path('pairs/*'),
        optional: true,
        emit: pairs

    tuple val(context), path('region_filter.log'),
        emit: log

    script:
    assert (opts.U != null) != (opts.k != null) :
        "RegionFilter requires exactly one of U or k"

    assert opts.eps == null || opts.k != null :
        "RegionFilter: eps requires k"

    assert opts.no_fallback != true || opts.closed == true :
        "RegionFilter: no_fallback requires closed"

    def command = new CommandBuilder("./${executable}")
        .addIf(opts.U != null, '--U', opts.U)
        .addIf(opts.k != null, '--k', opts.k)
        .add('--graph', graph)
        .add('--dump-fragment-graph', 'fragments.graph')
        .add('--dump-partition', 'fragment_mapping.txt')
        .add('--dump-regions', 'regions.txt')
        .add('--dump-cut-edges', 'cut_edges.txt')
        .addIf(opts.eps != null, '--eps', opts.eps)
        .addIf(opts.region_factor != null, '--region-factor', opts.region_factor)
        .addIf(opts.regions != null, '--regions', opts.regions)
        .addIf(opts.lloyd != null, '--lloyd', opts.lloyd)
        .addIf(opts.terminal_fraction != null, '--terminal-fraction', opts.terminal_fraction)
        .addIf(opts.margin != null, '--margin', opts.margin)
        .addIf(opts.terminals != null, '--terminals', opts.terminals)
        .addIf(opts.ball_fraction != null, '--ball-fraction', opts.ball_fraction)
        .addIf(opts.rounds != null, '--rounds', opts.rounds)
        .addIf(opts.min_rounds != null, '--min-rounds', opts.min_rounds)
        .addIf(opts.centers != null, '--centers', opts.centers)
        .addIf(opts.spread_fraction != null, '--spread-fraction', opts.spread_fraction)
        .addIf(opts.cut_side != null, '--cut-side', opts.cut_side)
        .addIf(opts.tau != null, '--tau', opts.tau)
        .addIf(opts.seed != null, '--seed', opts.seed)
        .addIf(opts.dump_pairs != null, '--dump-pairs', opts.dump_pairs, 'pairs/pair')
        .addIf(opts.pin_ring == true, '--pin-ring')
        .addIf(opts.closed == true, '--closed')
        .addIf(opts.no_fallback == true, '--no-fallback')
        .addIf(opts.no_tiny_cuts == true, '--no-tiny-cuts')
        .addIf(opts.verbose == true, '--verbose')

    // Accept a list or a comma-separated string.
    if (opts.region_factors != null) {
        def factors = CollectionUtils.asList(opts.region_factors)
            .join(',')

        command.add('--region-factors', factors)
    }

    def script = new ScriptBuilder()
        .addLine('mkdir -p pairs')
        .addCommand(command, 'region_filter.log', true)

    return script.build()
}
