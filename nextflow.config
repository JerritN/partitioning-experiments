outputDir = 'results'
workDir = '.work'
libDir = "${launchDir}/lib"

params {
    build_threads = 8

    mt_kahypar_revision = "085bdae"
    mt_kahypar = [
        cmake_preset: "minimal",
        definitions: [
            KAHYPAR_ENABLE_GRAPH_PARTITIONING_FEATURES: true
        ],
        binary: "mt-kahypar/application/MtKaHyPar",
        target: "MtKaHyPar"
    ]

    punch_filter_revision = "7467201"
    punch_filter = [
        cmake_preset: "minimal",
        binary: "tools/PunchFilter",
        target: "PunchFilter"
    ]

    region_filter_revision = "7467201"
    region_filter = [
        cmake_preset: "minimal",
        binary: "tools/RegionFilter",
        target: "RegionFilter"
    ]

    cache_git_checkout = true
    cache_cmake_build = true
    cache_mt_kahypar = true
    cache_punch_filter = true
    cache_region_filter = true
    cache_streetviz = true
}

// Machine-local overrides
params {
    graph_dir = "${env('HOME')}/"
    repository_dir = "${env('HOME')}/"
    project_path = "${env('HOME')}/"
}

includeConfig 'machine.config'
